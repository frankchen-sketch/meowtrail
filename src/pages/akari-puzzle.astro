---
import SEOHead from '../components/SEOHead.astro';
const title = "Akari Puzzle — Play Free Online";
const description = "Play Light Up (Akari) puzzle online for free. Place glowing cats to illuminate every cell in this cozy Japanese logic puzzle. No ads, no signup — just pure deduction.";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <SEOHead title={title} description={description} canonical="/akari-puzzle" type="website" />
  <style is:global>
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:"SF Pro Rounded","Segoe UI","Noto Sans SC",system-ui,sans-serif;background:#FBF8FF;color:#3B2B4B;min-height:100vh}
    .container{max-width:720px;margin:0 auto;padding:1rem}
    h1{font-size:1.8rem;color:#7B6B8A;text-align:center;margin:.5rem 0}
    .subtitle{text-align:center;color:#8B7B8B;margin-bottom:1rem;font-size:.95rem}
    .controls{display:flex;gap:.5rem;flex-wrap:wrap;justify-content:center;align-items:center;margin:.8rem 0}
    .controls select{padding:.4rem .6rem;border:2px solid #A888C8;border-radius:8px;background:#fff;font-size:.9rem;color:#3B2B4B;cursor:pointer;font-family:inherit}
    .btn{padding:.5rem 1rem;border:none;border-radius:12px;cursor:pointer;font-size:.9rem;font-weight:600;transition:transform .1s,background .2s;font-family:inherit}
    .btn:active{transform:scale(.95)}
    .btn-primary{background:#E8A888;color:#fff}.btn-primary:hover{background:#D09070}
    .btn-secondary{background:#F0E8FF;color:#7B6B8A}.btn-secondary:hover{background:#E0D0F0}
    .progress{text-align:center;font-size:.85rem;color:#8B7B8B;margin:.3rem 0;min-height:1.4rem}
    .toast{position:fixed;top:20px;left:50%;transform:translateX(-50%);background:#E74C3C;color:#fff;padding:.6rem 1.2rem;border-radius:12px;font-size:.9rem;font-weight:600;z-index:1000;opacity:0;transition:opacity .3s;pointer-events:none}
    .toast.show{opacity:1}.toast.success{background:#88C8A8}
    .grid-wrapper{display:flex;justify-content:center;margin:.5rem 0}
    .puzzle-grid{display:inline-grid;gap:2px;background:#E8DDD8;padding:4px;border-radius:12px;box-shadow:0 4px 16px rgba(123,107,138,.1)}
    .cell{display:flex;align-items:center;justify-content:center;border-radius:8px;user-select:none;cursor:pointer;transition:background .15s,box-shadow .15s;position:relative;overflow:hidden}
    .cell-black{background:#7B6B8A;cursor:default;box-shadow:inset 0 2px 4px rgba(0,0,0,.25)}
    .cell-number{font-weight:800;color:#F0E8FF}
    .cell-lit{background:#FFF8F0}
    .cell-cat{background:#F0E8FF;background-image:url('/assets/options/paw-purple.png');background-size:60%;background-repeat:no-repeat;background-position:center;box-shadow:inset 0 0 12px rgba(200,168,232,.3)}
    .cell-x{background:#FAFAFA}
    .cell-dark{background:#F0EBE5}
    @keyframes hint-pulse{0%,100%{box-shadow:inset 0 0 0 3px #C8A8E8}50%{box-shadow:inset 0 0 0 3px #C8A8E8,0 0 16px rgba(200,168,232,.5)}}
    .cell-hint{animation:hint-pulse 0.8s ease-in-out infinite}
    @keyframes flash-red{0%,100%{box-shadow:none}50%{box-shadow:inset 0 0 0 3px #E74C3C,0 0 8px rgba(231,76,60,.4)}}
    .cell-violation{animation:flash-red .5s ease}
    @keyframes shake{0%,100%{transform:translateX(0)}20%,60%{transform:translateX(-3px)}40%,80%{transform:translateX(3px)}}
    .cell-shake{animation:shake .4s ease}
    @keyframes cat-pop{0%{transform:scale(0)}60%{transform:scale(1.2)}100%{transform:scale(1)}}
    .win-overlay{position:fixed;inset:0;background:rgba(251,248,255,.92);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:999;opacity:0;transition:opacity .4s;pointer-events:none}
    .win-overlay.show{opacity:1;pointer-events:auto}
    .win-cat{animation:cat-pop .6s ease forwards}
    .win-text{font-size:1.6rem;font-weight:800;color:#7B6B8A;margin-top:1rem}
    .win-sub{font-size:1rem;color:#8B7B8B;margin-top:.3rem}
    .win-btn{margin-top:1.5rem;padding:.7rem 2rem;background:#E8A888;color:#fff;border:none;border-radius:12px;font-size:1rem;font-weight:600;cursor:pointer;font-family:inherit}
    .win-btn:hover{background:#D09070}
    .seo-content{margin-top:1.5rem;padding-top:1.5rem;border-top:2px solid #E0D0F0}
    .seo-content p{margin:.5rem 0;line-height:1.7}
    .seo-content ol,.seo-content ul{padding-left:1.5rem;margin:.5rem 0}
    .seo-content li{margin-bottom:.4rem}
    .seo-content a{color:#A888C8;text-decoration:underline}
    .seo-content h2{font-size:1.3rem;color:#7B6B8A;margin:1.5rem 0 .5rem}
    .seo-content h3{font-size:1.1rem;color:#7B6B8A;margin:1rem 0 .3rem}
    details{margin:.5rem 0;padding:.5rem .8rem;background:#FBF8FF;border-radius:8px}
    summary{cursor:pointer;font-weight:600;color:#A888C8}
    footer{text-align:center;margin:2rem 0 1rem;font-size:.8rem;color:#8B7B8B}
    footer a{color:#8B7B8B}
    @media(max-width:480px){h1{font-size:1.3rem}.controls{gap:.3rem}.btn{padding:.4rem .7rem;font-size:.8rem}}
  </style>
</head>
<body>
  <div class="container">
    <h1>🐱 Akari Puzzle: The Classic Light Up Game, Reimagined with Cats</h1>
    <p class="subtitle">Play the beloved Japanese logic puzzle Akari online — with adorable cat visuals.</p>
    <div class="controls">
      <select id="difficulty-select"><option value="easy" selected>Easy (7×7)</option><option value="medium">Medium (10×10)</option><option value="hard">Hard (12×12)</option></select>
      <button class="btn btn-primary" id="new-btn">🔄 New Puzzle</button>
      <button class="btn btn-secondary" id="hint-btn">💡 Hint</button>
      <button class="btn btn-secondary" id="reset-btn">↺ Reset</button>
    </div>
    <div class="progress" id="progress"></div>
    <div class="grid-wrapper"><div class="puzzle-grid" id="puzzle-grid"></div></div>
    <div class="toast" id="toast"></div>
    <div class="win-overlay" id="win-overlay">
      <div class="win-cat"><svg width="120" height="120" viewBox="0 0 120 120"><defs><radialGradient id="wg" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#C8A8E8" stop-opacity="0.6"/><stop offset="100%" stop-color="#C8A8E8" stop-opacity="0"/></radialGradient></defs><circle cx="60" cy="60" r="58" fill="url(#wg)"/><circle cx="60" cy="65" r="30" fill="#C8A8E8"/><polygon points="35,42 42,18 52,42" fill="#C8A8E8"/><polygon points="68,42 78,18 85,42" fill="#C8A8E8"/><circle cx="48" cy="58" r="4" fill="#7B6B8A"/><circle cx="72" cy="58" r="4" fill="#7B6B8A"/><ellipse cx="60" cy="68" rx="4" ry="3" fill="#E8A888"/><path d="M56,70 Q60,76 64,70" fill="none" stroke="#7B6B8A" stroke-width="1.5" stroke-linecap="round"/></svg></div>
      <div class="win-text">🎉 Meow-velous! 🐱✨</div>
      <button class="win-btn" id="win-next">Next Puzzle →</button>
    </div>
    <section class="seo-content">
      <h2>The History of Akari</h2>
      <p><strong>Akari</strong> (あかり, meaning "light" in Japanese) is a <strong>Japanese logic puzzle</strong> created by <a href="https://www.nikoli.co.jp/en/">Nikoli</a>, the legendary Japanese puzzle publisher behind Sudoku, Kakuro, and dozens of other beloved puzzles. First published in 2001, Akari quickly became a favorite among fans of <strong>Japanese logic puzzles</strong> for its unique combination of <strong>spatial reasoning</strong> and <strong>constraint satisfaction</strong>.</p>
      <p>Like Sudoku, Akari is a grid-based deduction puzzle with a unique solution — but instead of placing numbers, you place light sources that illuminate rows and columns. This makes it a <strong>spatial logic puzzle</strong> rather than an arithmetic one, which is why many players find it more relaxing than number-based puzzles.</p>
      <p>MeowTrail reimagines this classic <strong>Japanese logic puzzle</strong> with a <strong>cozy cat theme</strong>: instead of light bulbs, you place glowing cats. The warm golden illumination and adorable cat visuals transform the puzzle into a healing, meditative experience.</p>
      <h2>What Makes Japanese Logic Puzzles Special?</h2>
      <p>Japan's <a href="https://www.nikoli.co.jp/en/">Nikoli</a> has been inventing logic puzzles since 1980. Their puzzles share a common philosophy: <strong>every puzzle must have a unique solution solvable through pure logic alone</strong>. No guessing, no trivia, no luck — just deduction.</p>
      <p>The most famous Japanese logic puzzles include:</p>
      <ul>
        <li><strong>Sudoku</strong> — number placement in a 9×9 grid (Nikoli popularized it worldwide)</li>
        <li><strong>Kakuro</strong> — cross-sum puzzles combining arithmetic and logic</li>
        <li><strong>Nonograms</strong> (Picross) — paint-by-number grid art</li>
        <li><strong>Slitherlink</strong> — draw a single loop following numbered clues</li>
        <li><strong>Akari</strong> (Light Up) — place light bulbs to illuminate a grid</li>
      </ul>
      <p>Akari stands out among Japanese logic puzzles because it uses <strong>light propagation</strong> as its core mechanic. You don't just place symbols — you watch light spread across the grid in real time, creating a visual feedback loop that's deeply satisfying.</p>
      <h2>Complete Akari Rules</h2>
      <ol>
        <li><strong>Numbered black cells</strong> — A black cell with number N (0–4) must have exactly N cats in its four adjacent cells.</li>
        <li><strong>Illumination</strong> — Each cat illuminates its entire row and column until blocked by a wall.</li>
        <li><strong>No cat conflicts</strong> — Two cats cannot see each other in the same row or column without a wall between them.</li>
        <li><strong>Complete illumination</strong> — Every white cell must be illuminated by at least one cat.</li>
      </ol>
      <h2>Akari Solving Techniques</h2>
      <h3>Technique 1: Constraint Propagation</h3>
      <p>Start by examining numbered black cells. A "2" cell with 2 cats already → mark remaining neighbors as X. A "3" cell with only 3 available neighbors → all three must be cats. A "0" cell → mark all four neighbors as X immediately.</p>
      <h3>Technique 2: Line-of-Sight Elimination</h3>
      <p>When you place a cat, it illuminates its entire row and column. No other cat can be placed in the same unobstructed line. A white cell that can only be lit from <strong>one remaining position</strong> forces a cat there.</p>
      <h3>Technique 3: Elimination Reasoning (Advanced)</h3>
      <p>When constraint propagation gets stuck, use hypothetical deduction. Assume a cat at position X → propagate consequences → if contradiction found, X cannot hold a cat. This technique separates Easy puzzles from Hard ones.</p>
      <h2>Difficulty Levels</h2>
      <table style="width:100%;border-collapse:collapse;margin:.8rem 0;font-size:.95rem;">
        <thead><tr style="border-bottom:2px solid #A888C8;text-align:left;"><th style="padding:.4rem;">Level</th><th style="padding:.4rem;">Grid</th><th style="padding:.4rem;">Techniques Needed</th></tr></thead>
        <tbody>
          <tr style="border-bottom:1px solid #E0D0F0;"><td style="padding:.4rem;"><strong>Easy</strong></td><td style="padding:.4rem;">7×7</td><td style="padding:.4rem;">Constraint propagation only</td></tr>
          <tr style="border-bottom:1px solid #E0D0F0;"><td style="padding:.4rem;"><strong>Medium</strong></td><td style="padding:.4rem;">10×10</td><td style="padding:.4rem;">Propagation + 1–4 elimination steps</td></tr>
          <tr><td style="padding:.4rem;"><strong>Hard</strong></td><td style="padding:.4rem;">12×12</td><td style="padding:.4rem;">Propagation + multiple elimination chains</td></tr>
        </tbody>
      </table>
      <h2>Why MeowTrail's Cat Theme Works</h2>
      <p>The original Akari uses light bulbs — functional but cold. MeowTrail replaces them with <strong>glowing cats</strong>: warm, round, and emotionally inviting. The cat theme lowers the intimidation barrier for new players. A grid with cute cats looks like play, not homework.</p>
      <h2>FAQ</h2>
      <details><summary>Is Akari the same as Light Up?</summary><p>Yes. "Akari" is the original Japanese name by Nikoli. "Light Up" is the English localization.</p></details>
      <details><summary>How is Akari different from Sudoku?</summary><p>Akari uses spatial reasoning instead of number placement. No math needed — just careful observation.</p></details>
      <details><summary>Can every Akari puzzle be solved without guessing?</summary><p>Yes, if it has a unique solution. MeowTrail's puzzles are verified to have exactly one solution.</p></details>
      <details><summary>What does the number 0 mean?</summary><p>A "0" means none of its four adjacent cells can contain a cat. It immediately eliminates four positions.</p></details>
      <h2>More from MeowTrail</h2>
      <ul>
        <li><a href="/">Play MeowTrail</a> — the main game</li>
        <li><a href="/cat-logic-puzzle">Cat Logic Puzzle Guide</a> — beginner-friendly strategies</li>
        <li><a href="/puzzle/puzzle-001">Puzzle #001 with Solution</a> — step-by-step walkthrough</li>
      </ul>
    </section>
    <footer><p>MeowTrail — Akari Puzzle with Cats · <a href="/" style="color:#8B7B8B">Play More</a></p></footer>
  </div>
  <script is:inline src="/akari-engine.js"></script>
  <script>

    var CAT_IMG = '<img src="/assets/options/cat-purple.png" style="width:85%;height:85%;object-fit:contain;position:relative;z-index:2;filter:drop-shadow(0 2px 4px rgba(123,107,138,.3))" />';
    var X_MARK = '<svg viewBox="0 0 24 24" width="50%" height="50%" style="opacity:0.4"><line x1="6" y1="6" x2="18" y2="18" stroke="#B8A8C8" stroke-width="2.5" stroke-linecap="round"/><line x1="18" y1="6" x2="6" y2="18" stroke="#B8A8C8" stroke-width="2.5" stroke-linecap="round"/></svg>';

    var SIZE_MAP = { easy: 7, medium: 10, hard: 12 }, DIRS = [[-1,0],[1,0],[0,-1],[0,1]];
    var currentPuzzle = null, playerSolution = null, markX = null, won = false;
    var gridEl = document.getElementById('puzzle-grid'), progressEl = document.getElementById('progress'), toastEl = document.getElementById('toast'), diffSelect = document.getElementById('difficulty-select'), winOverlay = document.getElementById('win-overlay'), toastTimer = null;

    function showToast(m, t) { toastEl.textContent = m; toastEl.className = 'toast show' + (t === 'success' ? ' success' : ''); if (toastTimer) clearTimeout(toastTimer); toastTimer = setTimeout(function() { toastEl.className = 'toast'; }, 2500); }

    function newPuzzle() {
      var d = diffSelect.value, s = SIZE_MAP[d]; won = false; winOverlay.classList.remove('show');
      gridEl.innerHTML = '<div style="padding:2rem;color:#8B7B8B;font-size:0.9rem;">Generating...</div>'; progressEl.textContent = '';
      setTimeout(function() {
        try { currentPuzzle = generatePuzzle(s); playerSolution = []; markX = []; for (var i = 0; i < s; i++) { playerSolution.push(new Array(s).fill(false)); markX.push(new Array(s).fill(false)); } renderBoard(); updateProgress(); } catch (e) { showToast('Failed to generate.', 'error'); }
      }, 10);
    }

    function resetPuzzle() { if (!currentPuzzle) return; won = false; winOverlay.classList.remove('show'); var s = currentPuzzle.size; playerSolution = []; markX = []; for (var i = 0; i < s; i++) { playerSolution.push(new Array(s).fill(false)); markX.push(new Array(s).fill(false)); } renderBoard(); updateProgress(); showToast('Board reset!', 'success'); }

    function renderBoard() {
      if (!currentPuzzle) return;
      var g = currentPuzzle.grid, s = currentPuzzle.size, lit = illuminate(g, playerSolution, s), v = checkViolations(g, playerSolution, s), vc = {}, cp = {};
      v.forEach(function(x) { if (x.type === 'number_excess') { vc[x.row + ',' + x.col] = true; DIRS.forEach(function(d) { var nr = x.row + d[0], nc = x.col + d[1]; if (nr >= 0 && nr < s && nc >= 0 && nc < s && playerSolution[nr][nc]) vc[nr + ',' + nc] = true; }); } else if (x.type === 'cat_conflict') { cp[x.row + ',' + x.col] = true; cp[x.row2 + ',' + x.col2] = true; } });
      var mw = Math.min(window.innerWidth - 40, 600), cs = Math.max(30, Math.min(44, Math.floor((mw - (s + 1) * 2 - 8) / s)));
      gridEl.style.gridTemplateColumns = 'repeat(' + s + ',' + cs + 'px)'; gridEl.style.gridTemplateRows = 'repeat(' + s + ',' + cs + 'px)'; gridEl.innerHTML = '';
      for (var r = 0; r < s; r++) for (var c = 0; c < s; c++) {
        var cell = document.createElement('div'); cell.className = 'cell'; cell.style.width = cs + 'px'; cell.style.height = cs + 'px'; cell.dataset.row = r; cell.dataset.col = c;
        var val = g[r][c], key = r + ',' + c;
        if (val !== 9) { cell.classList.add('cell-black'); if (val >= 0) { cell.classList.add('cell-number'); cell.textContent = val; cell.style.fontSize = Math.max(12, cs * .5) + 'px'; if (vc[key]) cell.classList.add('cell-violation'); } }
        else {
          if (playerSolution[r][c]) { cell.classList.add('cell-cat'); cell.innerHTML = CAT_IMG; if (cp[key]) cell.classList.add('cell-shake'); }
          else if (markX[r][c]) { cell.classList.add('cell-x'); cell.innerHTML = X_MARK; }
          else if (lit[r][c]) { cell.classList.add('cell-lit'); }
          else { cell.classList.add('cell-dark'); }
          (function(r2, c2) {
            cell.addEventListener('click', function(e) { e.preventDefault(); if (!won) handleClick(r2, c2); });
            cell.addEventListener('dblclick', function(e) { e.preventDefault(); if (!won) { markX[r2][c2] = !markX[r2][c2]; renderBoard(); } });
            cell.addEventListener('contextmenu', function(e) { e.preventDefault(); if (!won) { markX[r2][c2] = !markX[r2][c2]; renderBoard(); } });
            var lpt = null, dlp = false;
            cell.addEventListener('touchstart', function() { dlp = false; lpt = setTimeout(function() { dlp = true; if (!won) { markX[r2][c2] = !markX[r2][c2]; renderBoard(); } }, 500); }, { passive: true });
            cell.addEventListener('touchend', function(e) { if (lpt) clearTimeout(lpt); if (dlp) e.preventDefault(); });
            cell.addEventListener('touchmove', function() { if (lpt) clearTimeout(lpt); }, { passive: true });
          })(r, c);
        }
        gridEl.appendChild(cell);
      }
    }

    function handleClick(r, c) {
      if (!currentPuzzle) return; var g = currentPuzzle.grid, s = currentPuzzle.size;
      if (playerSolution[r][c]) playerSolution[r][c] = false;
      else { markX[r][c] = false; playerSolution[r][c] = true; var v = checkViolations(g, playerSolution, s); for (var i = 0; i < v.length; i++) { if (v[i].type === 'number_excess') { showToast('Too many cats around number ' + v[i].number + '!', 'error'); break; } } for (var i = 0; i < v.length; i++) { if (v[i].type === 'cat_conflict') { showToast('Two cats are facing each other!', 'error'); break; } } }
      renderBoard(); updateProgress();
      if (checkWin(g, playerSolution, s)) { won = true; setTimeout(function() { winOverlay.classList.add('show'); }, 300); }
    }

    function updateProgress() { if (!currentPuzzle) return; var info = countLit(currentPuzzle.grid, playerSolution, currentPuzzle.size); progressEl.textContent = info.lit + ' / ' + info.total + ' cells lit'; }

    document.getElementById('hint-btn').addEventListener('click', function() { if (!currentPuzzle || won) return; var h = getHint(currentPuzzle.grid, currentPuzzle.solution, playerSolution, currentPuzzle.size); if (h) { var cell = gridEl.querySelector('[data-row="' + h[0] + '"][data-col="' + h[1] + '"]'); if (cell) { cell.classList.add('cell-hint'); setTimeout(function() { cell.classList.remove('cell-hint'); }, 2000); } showToast('Hint: try row ' + (h[0] + 1) + ', col ' + (h[1] + 1), 'success'); } else showToast('No hints!', 'error'); });
    document.getElementById('reset-btn').addEventListener('click', resetPuzzle);
    document.getElementById('new-btn').addEventListener('click', newPuzzle);
    document.getElementById('win-next').addEventListener('click', function() { winOverlay.classList.remove('show'); newPuzzle(); });
    diffSelect.addEventListener('change', newPuzzle);
    newPuzzle();
  </script>
</body>
</html>