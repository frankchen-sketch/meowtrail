---
import SEOHead from '../components/SEOHead.astro';

const title = "Play MeowTrail Online — Free Cat Puzzle Game";
const description = "Play MeowTrail (Akari) puzzles online for free. Choose difficulty and grid size, solve cat-themed logic puzzles in your browser. No download needed.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <SEOHead title={title} description={description} canonical="/play" type="website" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "MeowTrail Online",
    "url": "https://meowtrail.org/play",
    "description": description,
    "applicationCategory": "Game",
    "operatingSystem": "Web Browser",
    "gamePlatform": "Web Browser",
    "genre": "Puzzle"
  })} />
</head>
<body>
  <main>
    <h1>Play MeowTrail Online</h1>
    <p>{description}</p>

    <div id="game-controls">
      <label>Size:
        <select id="size-select">
          <option value="5">5×5</option>
          <option value="7" selected>7×7</option>
          <option value="9">9×9</option>
          <option value="12">12×12</option>
        </select>
      </label>
      <label>Difficulty:
        <select id="difficulty-select">
          <option value="easy">Easy</option>
          <option value="medium" selected>Medium</option>
          <option value="hard">Hard</option>
          <option value="ultra">Ultra</option>
        </select>
      </label>
      <button id="new-game">New Game</button>
      <button id="check-solution">Check Solution</button>
      <button id="show-hint">Hint</button>
    </div>

    <div id="puzzle-board" role="grid" aria-label="MeowTrail puzzle board"></div>

    <script>
      import { generatePuzzle, validateMove, validatePuzzle } from '../lib/puzzle-engine';
      console.log('MeowTrail puzzle engine loaded');
      // Game logic will be implemented in Phase 2
    </script>
  </main>
</body>
</html>
