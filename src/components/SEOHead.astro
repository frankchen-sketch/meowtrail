---
// Reusable SEO head component for all pages
// Usage: <SEOHead title="..." description="..." canonical="/play" />
// Auto-generates Article + BreadcrumbList JSON-LD for article pages

export interface Props {
  title: string;
  description: string;
  canonical: string;
  type?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  breadcrumbTitle?: string; // Override breadcrumb label (defaults to page title)
}

const {
  title,
  description,
  canonical,
  type = 'website',
  image = '/og-default.png',
  noindex = false,
  breadcrumbTitle,
} = Astro.props;

// Normalize: ensure trailing slash (match sitemap convention)
const normalizedCanonical = canonical === '/' ? '/' : (canonical.endsWith('/') ? canonical : `${canonical}/`);
const fullUrl = `https://meowtrail.org${normalizedCanonical}`;
const fullTitle = canonical === '/' ? title : (title.includes('MeowTrail') ? title : `${title} | MeowTrail`)

// Build BreadcrumbList from canonical path
const pathParts = normalizedCanonical.split('/').filter(Boolean);
const breadcrumbs = [
  { name: 'Home', url: 'https://meowtrail.org/' },
  ...pathParts.map((part, i) => {
    const url = 'https://meowtrail.org/' + pathParts.slice(0, i + 1).join('/') + '/';
    // Derive readable name from slug
    const name = part
      .replace(/^puzzle-/, 'Puzzle #')
      .replace(/-/g, ' ')
      .replace(/\b\w/g, c => c.toUpperCase());
    return { name, url };
  })
];

// Use breadcrumbTitle for the last crumb if provided
if (breadcrumbTitle && breadcrumbs.length > 1) {
  breadcrumbs[breadcrumbs.length - 1].name = breadcrumbTitle;
}

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: b.url,
  })),
};

const articleJsonLd = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title.replace(/ \| MeowTrail$/, ''),
  description,
  url: fullUrl,
  image: `https://meowtrail.org${image}`,
  author: { '@type': 'Organization', name: 'MeowTrail', url: 'https://meowtrail.org/' },
  publisher: { '@type': 'Organization', name: 'MeowTrail', url: 'https://meowtrail.org/' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': fullUrl },
} : null;
---

<!-- Primary Meta -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={fullUrl}>
{noindex && <meta name="robots" content="noindex">}

<!-- Open Graph -->
<meta property="og:type" content={type}>
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={fullUrl}>
<meta property="og:image" content={`https://meowtrail.org${image}`}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="MeowTrail — Free Akari Light Up Puzzle Game with Cats">
<meta property="og:site_name" content="MeowTrail">
<meta property="og:locale" content="en_US">

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={fullTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={`https://meowtrail.org${image}`}>

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg">

<!-- Preconnect for performance -->
<link rel="preconnect" href="https://meowtrail.org">

<!-- llms.txt reference -->
<link rel="alternate" type="text/plain" href="/llms.txt" title="AI-friendly site map">

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
{articleJsonLd && <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />}
