---
import SEOHead from '../components/SEOHead.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <SEOHead
    title="MeowTrail — Find Us Everywhere"
    description="Play MeowTrail Akari cat puzzle on all platforms. Find links to our profiles on AI directories, game platforms, and social media."
    canonical="https://meowtrail.app/community"
  />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #1a1625; color: #e8e0f0; line-height: 1.7; }
    .container { max-width: 720px; margin: 0 auto; padding: 60px 20px; }
    h1 { font-size: 2rem; margin-bottom: 12px; color: #f0e8ff; }
    .subtitle { color: #b8a8d0; margin-bottom: 40px; font-size: 1.05rem; }
    h2 { color: #C8A8E8; font-size: 1.2rem; margin: 32px 0 16px; border-bottom: 1px solid #2a2040; padding-bottom: 8px; }
    .link-card { display: flex; align-items: center; gap: 16px; padding: 16px; background: #231e30; border-radius: 10px; margin-bottom: 12px; text-decoration: none; color: #e8e0f0; transition: background 0.2s; }
    .link-card:hover { background: #2d2640; }
    .link-icon { font-size: 1.5rem; width: 40px; text-align: center; flex-shrink: 0; }
    .link-info h3 { font-size: 1rem; color: #f0e8ff; margin-bottom: 2px; }
    .link-info p { font-size: 0.85rem; color: #9888b0; }
    .link-badge { margin-left: auto; background: #E8A888; color: #1a1625; padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 600; flex-shrink: 0; }
    .back-link { display: inline-block; margin-top: 40px; color: #E8A888; text-decoration: none; }
    .back-link:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <div class="container">
    <h1>🐱 Find MeowTrail Everywhere</h1>
    <p class="subtitle">Play our free Akari cat puzzle game on any platform. Follow us for updates and new puzzles.</p>

    <h2>🎮 Play MeowTrail</h2>
    <a href="https://meowtrail.app" class="link-card">
      <span class="link-icon">🌐</span>
      <div class="link-info">
        <h3>meowtrail.app</h3>
        <p>Play free Akari puzzles in your browser</p>
      </div>
      <span class="link-badge">Official</span>
    </a>

    <h2>📂 AI Directories</h2>
    <a href="https://theresanaiforthat.com/@chen-yan-fan/" class="link-card">
      <span class="link-icon">🤖</span>
      <div class="link-info">
        <h3>There's An AI For That</h3>
        <p>AI tool directory — DR 77</p>
      </div>
    </a>
    <a href="https://theresanaiforthat.com/ai/furriq/" class="link-card">
      <span class="link-icon">🐱</span>
      <div class="link-info">
        <h3>TAAFT — Furriq</h3>
        <p>Our AI cat breed identifier</p>
      </div>
    </a>

    <h2>🛠️ Developer</h2>
    <a href="https://github.com/frankchen-sketch" class="link-card">
      <span class="link-icon">💻</span>
      <div class="link-info">
        <h3>GitHub</h3>
        <p>Open source projects and code</p>
      </div>
    </a>

    <h2>🐦 Social</h2>
    <a href="https://x.com/tryfurriq" class="link-card">
      <span class="link-icon">𝕏</span>
      <div class="link-info">
        <h3>@tryfurriq on X</h3>
        <p>Updates and cat content</p>
      </div>
    </a>

    <a href="/" class="back-link">← Back to MeowTrail</a>
  </div>
</body>
</html>
