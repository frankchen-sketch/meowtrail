---
import SEOHead from '../components/SEOHead.astro';

const title = "MeowTrail Cheats & Solutions — Online Akari Solver";
const description = "Stuck on a MeowTrail puzzle? Use our free online Akari solver. Enter your grid and get instant solutions. Plus: tips, walkthroughs, and level guides.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <SEOHead title={title} description={description} canonical="/cheats" type="article" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "MeowTrail Cheats & Solutions",
    "description": description,
    "url": "https://meowtrail.org/cheats",
    "author": { "@type": "Organization", "name": "MeowTrail Wiki" }
  })} />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; line-height: 1.6; color: #333; max-width: 800px; margin: 0 auto; padding: 1rem; }
    h1 { font-size: 2rem; margin-bottom: 0.5rem; }
    h2 { font-size: 1.4rem; margin: 1.5rem 0 0.5rem; color: #e67e22; }
    nav.breadcrumb { margin-bottom: 1rem; font-size: 0.9rem; color: #666; }
    nav.breadcrumb a { color: #e67e22; text-decoration: none; }
    ol { padding-left: 1.5rem; }
    li { margin-bottom: 0.5rem; }
    #solver-section { background: #fef9e7; border-radius: 12px; padding: 1.5rem; margin: 1.5rem 0; }
    #grid-builder { display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-start; margin: 1rem 0; }
    #grid-builder label { display: flex; align-items: center; gap: 0.5rem; }
    #grid-builder select, #grid-builder button { padding: 0.5rem 1rem; border-radius: 6px; border: 1px solid #ddd; font-size: 1rem; }
    #grid-builder button { background: #e67e22; color: white; border: none; cursor: pointer; }
    #grid-builder button:hover { background: #d35400; }
    #editor-board { display: inline-grid; gap: 2px; background: #333; padding: 2px; border-radius: 4px; margin: 1rem 0; }
    #editor-board .cell { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-weight: bold; font-size: 1.1rem; user-select: none; transition: background 0.15s; }
    #editor-board .cell.white { background: #ffeaa7; }
    #editor-board .cell.white:hover { background: #fdcb6e; }
    #editor-board .cell.black { background: #2d3436; color: white; }
    #editor-board .cell.black-number { background: #2d3436; color: #fdcb6e; font-size: 1.2rem; }
    #solve-btn { background: #27ae60; color: white; border: none; padding: 0.75rem 2rem; border-radius: 8px; font-size: 1.1rem; cursor: pointer; margin-top: 1rem; }
    #solve-btn:hover { background: #219a52; }
    #solve-btn:disabled { background: #bdc3c7; cursor: not-allowed; }
    #solution-output { margin-top: 1rem; padding: 1rem; border-radius: 8px; min-height: 2rem; }
    #solution-output.success { background: #d5f5e3; border: 1px solid #27ae60; }
    #solution-output.error { background: #fadbd8; border: 1px solid #e74c3c; }
    #solution-output.info { background: #d6eaf8; border: 1px solid #3498db; }
    .solution-board { display: inline-grid; gap: 2px; background: #333; padding: 2px; border-radius: 4px; margin-top: 0.5rem; }
    .solution-board .cell { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; font-size: 1rem; }
    .solution-board .cell.white { background: #ffeaa7; }
    .solution-board .cell.illuminated { background: #fff9c4; }
    .solution-board .cell.bulb { background: #fdcb6e; }
    .solution-board .cell.black { background: #2d3436; color: white; }
    .mode-toggle { display: flex; gap: 0.5rem; margin: 1rem 0; }
    .mode-toggle button { padding: 0.4rem 0.8rem; border: 2px solid #e67e22; background: white; color: #e67e22; border-radius: 6px; cursor: pointer; font-size: 0.9rem; }
    .mode-toggle button.active { background: #e67e22; color: white; }
    .instructions { font-size: 0.9rem; color: #666; margin: 0.5rem 0; }
    @media (prefers-color-scheme: dark) {
      body { background: #1a1a2e; color: #eee; }
      #solver-section { background: #16213e; }
      #editor-board .cell.white { background: #4a3f2a; }
      #editor-board .cell.white:hover { background: #5a4f3a; }
      #editor-board .cell.black, #editor-board .cell.black-number { background: #0f0f23; }
    }
  </style>
</head>
<body>
  <nav class="breadcrumb"><a href="/">Home</a> &gt; <span>Cheats & Solutions</span></nav>
  <main>
    <h1>MeowTrail Cheats & Solutions</h1>
    <p>Stuck on a puzzle? Use our free online solver — enter your grid and get the answer instantly.</p>

    <h2>💡 Before You Cheat — Try These Hints</h2>
    <ol>
      <li><strong>Start with "4" cells</strong> — all 4 neighbors must be bulbs</li>
      <li><strong>Start with "0" cells</strong> — all 4 neighbors must be empty</li>
      <li><strong>Look for forced positions</strong> — cells that can only be lit from one direction</li>
      <li><strong>Count remaining spots</strong> — if a "3" has 2 neighbors blocked, the other 2 must be bulbs</li>
    </ol>

    <h2>🔧 Online Akari Solver</h2>
    <section id="solver-section">
      <p><strong>Step 1:</strong> Set your grid size, then click cells to build your puzzle.</p>
      <div id="grid-builder">
        <label>Size: <select id="solver-size">
          <option value="5">5×5</option>
          <option value="7" selected>7×7</option>
          <option value="9">9×9</option>
          <option value="10">10×10</option>
        </select></label>
        <button id="reset-grid">Reset Grid</button>
      </div>

      <p class="instructions"><strong>Click mode:</strong></p>
      <div class="mode-toggle">
        <button id="mode-white" class="active">⬜ White Cell</button>
        <button id="mode-black">⬛ Black Wall</button>
        <button id="mode-number">🔢 Numbered Wall</button>
      </div>
      <p class="instructions">In number mode, click a black cell to cycle 0→1→2→3→4.</p>

      <div id="editor-board"></div>

      <br>
      <button id="solve-btn">🧩 Solve Puzzle</button>
      <div id="solution-output"></div>
    </section>

    <h2>📚 Level Guides</h2>
    <p>Coming soon — we're building walkthroughs for every MeowTrail level. Check back daily!</p>
  </main>

  <script>
    import { solvePuzzle, CellType, computeIllumination } from '../lib/puzzle-engine';
    import type { Puzzle, Cell } from '../lib/puzzle-engine';

    let gridSize = 7;
    let editMode: 'white' | 'black' | 'number' = 'white';
    let grid: number[][] = []; // 0=white, 1=black, 2-6=black0-black4

    function initGrid() {
      grid = Array.from({ length: gridSize }, () => Array(gridSize).fill(0));
      renderEditor();
    }

    function renderEditor() {
      const board = document.getElementById('editor-board')!;
      board.innerHTML = '';
      board.style.gridTemplateColumns = `repeat(${gridSize}, 40px)`;

      for (let r = 0; r < gridSize; r++) {
        for (let c = 0; c < gridSize; c++) {
          const cell = document.createElement('div');
          cell.className = 'cell';
          cell.dataset.row = String(r);
          cell.dataset.col = String(c);

          if (grid[r][c] === 0) {
            cell.classList.add('white');
          } else if (grid[r][c] >= 2) {
            cell.classList.add('black-number');
            cell.textContent = String(grid[r][c] - 2);
          } else {
            cell.classList.add('black');
          }

          cell.addEventListener('click', () => handleCellClick(r, c));
          board.appendChild(cell);
        }
      }
    }

    function handleCellClick(r: number, c: number) {
      if (editMode === 'white') {
        grid[r][c] = 0;
      } else if (editMode === 'black') {
        grid[r][c] = 1;
      } else if (editMode === 'number') {
        // Cycle: black → 0 → 1 → 2 → 3 → 4 → black
        if (grid[r][c] >= 2) {
          const next = grid[r][c] + 1;
          grid[r][c] = next > 6 ? 1 : next;
        } else {
          grid[r][c] = 2; // black0
        }
      }
      renderEditor();
    }

    function buildPuzzle(): Puzzle | null {
      const cells: Cell[][] = [];
      for (let r = 0; r < gridSize; r++) {
        cells[r] = [];
        for (let c = 0; c < gridSize; c++) {
          cells[r][c] = {
            type: grid[r][c] as CellType,
            bulb: false,
            illuminated: false,
          };
        }
      }
      return { size: gridSize, difficulty: 'medium', grid: cells };
    }

    function renderSolution(solution: { row: number; col: number }[]) {
      const puzzle = buildPuzzle()!;
      for (const s of solution) {
        puzzle.grid[s.row][s.col].bulb = true;
      }
      computeIllumination(puzzle.grid);

      const output = document.getElementById('solution-output')!;
      output.className = 'success';
      output.innerHTML = `<strong>✅ Solution found! (${solution.length} bulbs)</strong><br>`;

      const board = document.createElement('div');
      board.className = 'solution-board';
      board.style.gridTemplateColumns = `repeat(${gridSize}, 36px)`;

      for (let r = 0; r < gridSize; r++) {
        for (let c = 0; c < gridSize; c++) {
          const cell = document.createElement('div');
          cell.className = 'cell';
          const pc = puzzle.grid[r][c];

          if (pc.type >= 1) {
            cell.classList.add('black');
            if (pc.type >= 2) cell.textContent = String(pc.type - 2);
          } else if (pc.bulb) {
            cell.classList.add('bulb');
            cell.textContent = '💡';
          } else if (pc.illuminated) {
            cell.classList.add('illuminated');
          } else {
            cell.classList.add('white');
          }
          board.appendChild(cell);
        }
      }
      output.appendChild(board);
    }

    // Event listeners
    document.getElementById('solver-size')!.addEventListener('change', (e) => {
      gridSize = parseInt((e.target as HTMLSelectElement).value);
      initGrid();
    });

    document.getElementById('reset-grid')!.addEventListener('click', initGrid);

    document.getElementById('mode-white')!.addEventListener('click', () => {
      editMode = 'white';
      document.querySelectorAll('.mode-toggle button').forEach(b => b.classList.remove('active'));
      document.getElementById('mode-white')!.classList.add('active');
    });
    document.getElementById('mode-black')!.addEventListener('click', () => {
      editMode = 'black';
      document.querySelectorAll('.mode-toggle button').forEach(b => b.classList.remove('active'));
      document.getElementById('mode-black')!.classList.add('active');
    });
    document.getElementById('mode-number')!.addEventListener('click', () => {
      editMode = 'number';
      document.querySelectorAll('.mode-toggle button').forEach(b => b.classList.remove('active'));
      document.getElementById('mode-number')!.classList.add('active');
    });

    document.getElementById('solve-btn')!.addEventListener('click', () => {
      const puzzle = buildPuzzle();
      if (!puzzle) return;

      const btn = document.getElementById('solve-btn') as HTMLButtonElement;
      const output = document.getElementById('solution-output')!;
      btn.disabled = true;
      btn.textContent = '⏳ Solving...';
      output.className = 'info';
      output.textContent = 'Running solver...';

      // Use setTimeout to allow UI update before heavy computation
      setTimeout(() => {
        try {
          const result = solvePuzzle(puzzle, 1);
          if (result.solutions.length > 0) {
            renderSolution(result.solutions[0]);
          } else {
            output.className = 'error';
            output.innerHTML = '<strong>❌ No solution found.</strong><br>Check that your grid is valid — make sure numbered cells have the right count of adjacent white cells.';
          }
        } catch (e) {
          output.className = 'error';
          output.textContent = `Error: ${e}`;
        }
        btn.disabled = false;
        btn.textContent = '🧩 Solve Puzzle';
      }, 50);
    });

    // Init
    initGrid();
  </script>
</body>
</html>
