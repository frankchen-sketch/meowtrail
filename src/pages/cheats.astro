---
import SEOHead from '../components/SEOHead.astro';

const title = "MeowTrail Cheats & Solutions — Full Walkthrough";
const description = "Stuck on a MeowTrail level? Get hints, solutions, and full walkthroughs for every puzzle. Plus: free online Akari solver tool.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <SEOHead title={title} description={description} canonical="/cheats" type="article" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "MeowTrail Cheats & Solutions",
    "description": description,
    "url": "https://meowtrail.org/cheats",
    "author": { "@type": "Organization", "name": "MeowTrail Wiki" }
  })} />
</head>
<body>
  <nav aria-label="Breadcrumb"><a href="/">Home</a> &gt; <span>Cheats</span></nav>
  <main>
    <h1>MeowTrail Cheats & Solutions</h1>

    <h2>Need a Hint?</h2>
    <p>Before looking up the full solution, try these steps:</p>
    <ol>
      <li>Check all "4" and "0" cells first</li>
      <li>Look for cells that can only be lit from one direction</li>
      <li>Use the in-game hint button (it won't solve the puzzle for you)</li>
    </ol>

    <h2>Online Solver</h2>
    <p>Paste your puzzle grid below and get the solution:</p>
    <div id="solver-tool">
      <textarea id="grid-input" placeholder="Enter your puzzle grid..." rows="10" cols="40"></textarea>
      <button id="solve-btn">Solve</button>
      <div id="solution-output" aria-live="polite"></div>
    </div>
  </main>
</body>
</html>
